# --- MySQL / MariaDB target (never commit real creds; copy to .env) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=monitor
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=

# --- Web server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Storage ---
SQLITE_PATH=monitor.db

# --- Collection cadences (seconds) ---
SYSTEM_INTERVAL=5
MYSQL_INTERVAL=60
ANALYZE_INTERVAL=3600
REPORT_HOUR=2

# --- PM2 process tracking (optional; local pm2 daemon required) ---
# Set to true on the host running the PM2 apps you want to monitor.
# --- PM2 process tracking ---
PM2_ENABLED=true
PM2_INTERVAL=60
PM2_LOG_DIR=~/.pm2/logs
PM2_LOG_LINES=200
PM2_POOL_SIZE=5
PM2_APPS=shiksha-erp,shiksha-erp-api,shiksha-mobile
PM2_MYSQL_PORT=3306
# On-demand diagnostic (Python; /pm2 page -> Diagnose tab)
PM2_DIAGNOSE_ENABLED=true

# --- Alert thresholds ---
ALERT_CPU_HIGH=90.0
ALERT_MEM_AVAIL_LOW=10.0
ALERT_DISK_HIGH=90.0
ALERT_SLOW_QUERY_MS=5000
ALERT_DEADLOCK_TRIGGER=1

# --- API auth ---
API_TOKEN=changeme-token

# --- Dashboard auth ---
# Leave empty to disable password protection (dashboard is open to everyone).
# To enable: generate a bcrypt hash and paste it here.
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=
# Must be a long random string — used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string
